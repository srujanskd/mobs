  {
    "screen": "bonding",
    "labels": [
      {
        "text": "",
        "description": "Navigate up",
        "bounds": "[0,63][147,210]"
      },
      {
        "text": "Bonding and NoDrop options",
        "description": "",
        "bounds": "[189,101][875,172]"
      },
      {
        "text": "Bonding",
        "description": "",
        "bounds": "[189,273][1038,324]"
      },
      {
        "text": "Bonding is the process of using multiple internet connections, such as cellular + wifi, to improve streaming bandwidth and reliability.\nThere are two supported methods:",
        "description": "",
        "bounds": "[189,324][1038,504]"
      },
      {
        "text": "1. Own Bonding Server (SRTLA)",
        "description": "",
        "bounds": "[189,588][1038,639]"
      },
      {
        "text": "To use custom bonding server (IRL Toolkit, Belabox Cloud, SRTLA Server, etc), bonding, enter a provided connection url srtla://host:port",
        "description": "",
        "bounds": "[189,639][1038,776]"
      },
      {
        "text": "2. Connection Bonding Service",
        "description": "",
        "bounds": "[189,860][1038,911]"
      },
      {
        "text": "Built in Bonding (Courtesy of IRL Toolkit)\nWorks when streaming direct to Twitch, or an rtmp/srt server without bonding support.",
        "description": "",
        "bounds": "[189,911][1038,1048]"
      },
      {
        "text": "Bonding Only",
        "description": "",
        "bounds": "[189,1111][435,1168]"
      },
      {
        "text": "Only bond the connections, video is sent straight to the destination",
        "description": "",
        "bounds": "[189,1168][912,1262]"
      },
      {
        "text": "Connections",
        "description": "",
        "bounds": "[189,1367][1038,1418]"
      },
      {
        "text": "Enable Bonding for the following connections:",
        "description": "",
        "bounds": "[189,1418][939,1469]"
      },
      {
        "text": "Advanced Bonding Settings",
        "description": "",
        "bounds": "[189,1553][1038,1604]"
      },
      {
        "text": "Tune what links are enabled when bonding and their relative weights. Weights are relative so don't have an effect if only one connection enabled.\nThis can be adjusted live in the quick settings network tab.",
        "description": "",
        "bounds": "[189,1604][1038,1827]"
      },
      {
        "text": "Enable Cellular",
        "description": "",
        "bounds": "[189,1890][464,1947]"
      },
      {
        "text": "Cellular Weight",
        "description": "",
        "bounds": "[189,2010][468,2067]"
      },
      {
        "text": "100",
        "description": "",
        "bounds": "[901,2101][996,2158]"
      },
      {
        "text": "Enable WiFi",
        "description": "",
        "bounds": "[189,2255][405,2312]"
      }
    ]
  },
